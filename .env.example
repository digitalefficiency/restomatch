# DB
DATABASE_URL=postgres://romkoren@localhost:5432/restomatch
DATABASE_URL_TEST=postgres://romkoren@localhost:5432/restomatch_test

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Auth
AUTH_SECRET=replace-me-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# Email (Resend / Postmark) — leave blank in dev to log magic links to console
EMAIL_FROM=auth@restomatch.local
RESEND_API_KEY=

# OCR (leave blank for milestone 1-3 — mocks are used)
GOOGLE_DOCUMENT_AI_PROJECT_ID=
GOOGLE_DOCUMENT_AI_LOCATION=eu
ANTHROPIC_API_KEY=

# Procurement platforms (leave blank — mocks used until pilot)
MARKETMAN_API_KEY=
MARKETMAN_BASE_URL=https://api.marketman.com/v3

# Storage (S3 / R2 / MinIO) — milestone 4+
S3_ENDPOINT=
S3_BUCKET=restomatch-invoices
S3_ACCESS_KEY=
S3_SECRET_KEY=
