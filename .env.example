# ── Database (Supabase Postgres) ──────────────────────────────────────────
# Owner/service pooled connection — used by the WORKER + migrations + the
# Auth.js identity layer (full access; bypasses RLS).
#   Supabase dashboard → Project Settings → Database → Connection pooling (6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# NON-OWNER, RLS-ENFORCED role for the WEB app's tenant queries. Provision a
# dedicated login role (mirror packages/db/src/rls.ts ensureRlsAppRole grants)
# with rolbypassrls=false. Until set, the web falls back to DATABASE_URL and
# RLS is effectively inert — set this before going live.
DATABASE_URL_APP=postgresql://restomatch_app:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Direct connection — used by migrations only (port 5432).
DATABASE_URL_DIRECT=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Local Postgres for the test suite.
DATABASE_URL_TEST=postgres://postgres@localhost:5432/restomatch_test

# ── Supabase Storage (invoice scans) ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<anon / publishable key>
# Server-only — REQUIRED for /scans: the bucket is private and documents are
# served via short-lived signed URLs created with this key.
SUPABASE_SERVICE_ROLE_KEY=

# ── Redis (BullMQ worker + web rate limiting) ─────────────────────────────
# Used by the worker queues AND the web app's magic-link rate limiter. If
# unset, the web rate limiter falls back to a process-local counter.
REDIS_URL=redis://localhost:6379

# Public base URL of the deployment — used for the tRPC Origin/CSRF check.
APP_URL=https://app.restomatch.co

# ── Auth (Auth.js) ────────────────────────────────────────────────────────
AUTH_SECRET=replace-me-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
EMAIL_FROM=auth@restomatch.co.il
# Resend — leave blank in dev to log magic links to the server console.
RESEND_API_KEY=

# ── OCR ───────────────────────────────────────────────────────────────────
# Leave blank to use fixture stubs. Set both providers for production OCR.
GOOGLE_DOCUMENT_AI_PROJECT_ID=
GOOGLE_DOCUMENT_AI_LOCATION=eu
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=
GOOGLE_APPLICATION_CREDENTIALS=
ANTHROPIC_API_KEY=

# ── Procurement (MarketMan) ───────────────────────────────────────────────
MARKETMAN_API_KEY=
MARKETMAN_BASE_URL=https://api.marketman.com/v3

# ── WhatsApp Cloud (Meta) ─────────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ── Observability (optional — no-op when blank) ───────────────────────────
SENTRY_DSN=
SENTRY_ENV=development
POSTHOG_API_KEY=
NEXT_PUBLIC_POSTHOG_KEY=

# ── Feature flags ─────────────────────────────────────────────────────────
# Render showcase demo papers on /scans outside production (1 to force-enable).
NEXT_PUBLIC_ENABLE_SCAN_MOCKS=
