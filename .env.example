# ── Database (Supabase Postgres) ──────────────────────────────────────────
# Owner/service pooled connection — used by the WORKER + migrations + the
# Auth.js identity layer (full access; bypasses RLS).
#   Supabase dashboard → Project Settings → Database → Connection pooling (6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# NON-OWNER, RLS-ENFORCED role for the WEB app's tenant queries. Provision a
# dedicated login role (mirror packages/db/src/rls.ts ensureRlsAppRole grants)
# with rolbypassrls=false. REQUIRED to serve tenant traffic — resolveWebDbUrl()
# is fail-closed and the boot guard refuses an RLS-bypassing role (Epic 0.1/0.2).
DATABASE_URL_APP=postgresql://restomatch_app:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Dev/test ONLY escape hatch: serve tenant traffic on the owner DATABASE_URL
# (which BYPASSES RLS) when DATABASE_URL_APP is unset. Rejected in production.
# ALLOW_OWNER_DB=1
# Direct connection — used by migrations only (port 5432).
DATABASE_URL_DIRECT=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Password for the non-owner `restomatch_app` login role created by
# `pnpm --filter @restomatch/db provision-rls` (ensureRlsAppRole). REQUIRED when
# provisioning a non-local database; local/test DBs fall back to a throwaway.
APP_ROLE_PASSWORD=
# Local Postgres for the test suite (matches docker-compose + CI).
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/restomatch_test

# ── Supabase Storage (invoice scans) ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<anon / publishable key>
# Server-only — REQUIRED for /scans: the bucket is private and documents are
# served via short-lived signed URLs created with this key.
SUPABASE_SERVICE_ROLE_KEY=

# ── Redis (BullMQ worker + web rate limiting) ─────────────────────────────
# Used by the worker queues AND the web app's magic-link rate limiter. If
# unset, the web rate limiter falls back to a process-local counter.
REDIS_URL=redis://localhost:6379

# Public base URL of the deployment — used for the tRPC Origin/CSRF check.
APP_URL=https://app.restomatch.co

# ── Auth (Auth.js) ────────────────────────────────────────────────────────
AUTH_SECRET=replace-me-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
EMAIL_FROM=auth@restomatch.co.il
# Resend — leave blank in dev to log magic links to the server console.
RESEND_API_KEY=
# REQUIRED in production: 32-byte key (hex) that encrypts TOTP secrets at rest
# (2FA, Epic C). Boot fails without it. Generate: openssl rand -hex 32
# Losing it makes every enrolled TOTP secret undecryptable — back it up.
AUTH_ENC_KEY=
# Number of trusted reverse proxies in front of the app (Vercel = 1). Rate
# limiters then read the client IP from the right of x-forwarded-for instead of
# the spoofable left-most entry (D1.6). Leave unset only for bare local dev.
TRUSTED_PROXY_HOPS=1
# Vercel Cron authenticates /api/cron/* with `Authorization: Bearer <CRON_SECRET>`.
# Required in production (the worker watchdog route returns 401 otherwise).
CRON_SECRET=
# Who gets the "worker is down" email (comma-separated). Falls back to
# PLATFORM_ADMIN_EMAILS.
WORKER_ALERT_EMAILS=

# ── OCR ───────────────────────────────────────────────────────────────────
# Leave blank to use fixture stubs. Set both providers for production OCR.
GOOGLE_DOCUMENT_AI_PROJECT_ID=
GOOGLE_DOCUMENT_AI_LOCATION=eu
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=
GOOGLE_APPLICATION_CREDENTIALS=
ANTHROPIC_API_KEY=

# ── Procurement (MarketMan) ───────────────────────────────────────────────
MARKETMAN_API_KEY=
MARKETMAN_BASE_URL=https://api.marketman.com/v3

# ── WhatsApp Cloud (Meta) ─────────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ── Observability (optional — no-op when blank) ───────────────────────────
SENTRY_DSN=
SENTRY_ENV=development
POSTHOG_API_KEY=
NEXT_PUBLIC_POSTHOG_KEY=

# ── Feature flags ─────────────────────────────────────────────────────────
# Render showcase demo papers on /scans outside production (1 to force-enable).
NEXT_PUBLIC_ENABLE_SCAN_MOCKS=
