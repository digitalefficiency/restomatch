{
  "name": "@restomatch/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./serverless": "./src/serverless.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed:chain-demo": "tsx scripts/seed-chain-demo.ts",
    "seed:recovery-demo": "tsx scripts/seed-recovery-demo.ts",
    "seed:recipes-demo": "tsx scripts/seed-recipes-demo.ts",
    "seed:inventory-demo": "tsx scripts/seed-inventory-demo.ts",
    "seed:contracts-demo": "tsx scripts/seed-wave1-contracts-demo.ts",
    "reseed:demo": "tsx scripts/reseed-demo.ts",
    "check:demo": "tsx scripts/check-demo.ts"
  },
  "dependencies": {
    "@restomatch/api": "workspace:*",
    "@restomatch/catalog": "workspace:*",
    "@restomatch/charts": "workspace:*",
    "@restomatch/db": "workspace:*",
    "@restomatch/matching": "workspace:*",
    "@restomatch/observability": "workspace:*",
    "@restomatch/ocr": "workspace:*",
    "@restomatch/procurement": "workspace:*",
    "@restomatch/queue": "workspace:*",
    "@restomatch/translate": "workspace:*",
    "@restomatch/types": "workspace:*",
    "cron-parser": "5.10.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
