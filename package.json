{
  "name": "restomatch",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "db:generate": "pnpm --filter @restomatch/db generate",
    "db:migrate": "pnpm --filter @restomatch/db migrate",
    "db:seed": "pnpm --filter @restomatch/db seed",
    "db:studio": "pnpm --filter @restomatch/db studio",
    "test": "turbo run test --concurrency=1",
    "test:e2e": "pnpm --filter @restomatch/web test:e2e"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
